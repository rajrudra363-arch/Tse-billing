rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/\\\\].*');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'rajrudra363@gmail.com' &&
         request.auth.token.email_verified == true)
      );
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function memberDoc(workspaceId, uid) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid));
    }

    function isMemberLoginActive(workspaceId) {
      return !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) ||
        memberDoc(workspaceId, request.auth.uid).data.get('loginEnabled', true) == true;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        workspaceDoc(workspaceId).data.ownerUid == request.auth.uid;
    }

    function isWorkspaceAdmin(workspaceId) {
      return (isBootstrappedAdmin() || isWorkspaceOwner(workspaceId) ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
          memberDoc(workspaceId, request.auth.uid).data.role == 'admin')) &&
        !isTechnicianMember(workspaceId) &&
        !isSuperAdminMember(workspaceId);
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && isMemberLoginActive(workspaceId) && (
        isWorkspaceAdmin(workspaceId) ||
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
      );
    }

    function isTechnicianMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        memberDoc(workspaceId, request.auth.uid).data.role == 'technician' &&
        memberDoc(workspaceId, request.auth.uid).data.get('loginEnabled', true) == true;
    }

    function isSuperAdminMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        memberDoc(workspaceId, request.auth.uid).data.role == 'super_admin' &&
        memberDoc(workspaceId, request.auth.uid).data.get('loginEnabled', true) == true;
    }

    // Strict Super Admin ONLY check for Employee & Salary Management:
    // Explicitly denies Admin and Technician roles.
    function isStrictSuperAdmin(companyId) {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        request.auth.token.email != 'rajrudra363@gmail.com' &&
        (!exists(/databases/$(database)/documents/workspaces/$(companyId)) ||
          workspaceDoc(companyId).data.ownerUid != request.auth.uid) &&
        !isTechnicianMember(companyId) &&
        (
          isSuperAdminMember(companyId) ||
          request.auth.token.get('role', '') == 'super_admin' ||
          exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
        );
    }

    function isValidWorkspaceCreate(workspaceId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'workspaceId', 'ownerUid', 'ownerEmail', 'techShareCode', 'superShareCode',
          'companyName', 'mobile', 'email', 'address', 'upiId', 'payeeName',
          'logoBase64', 'authorisedSignatureBase64', 'fallbackQrBase64',
          'headerNote', 'voiceLogin', 'voicePostLogin', 'voiceBillStart',
          'voiceBillDone', 'voiceModelId', 'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasOnly([
          'workspaceId', 'companyId', 'ownerUid', 'ownerEmail', 'techShareCode', 'superShareCode',
          'companyName', 'mobile', 'email', 'address', 'upiId', 'payeeName',
          'logoBase64', 'authorisedSignatureBase64', 'fallbackQrBase64',
          'headerNote', 'voiceLogin', 'voicePostLogin', 'voiceBillStart',
          'voiceBillDone', 'voiceModelId', 'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        d.workspaceId == workspaceId &&
        d.ownerUid == request.auth.uid &&
        d.ownerEmail is string &&
        d.techShareCode is string && d.techShareCode.size() >= 8 && d.techShareCode.size() <= 64 &&
        d.superShareCode is string && d.superShareCode.size() >= 8 && d.superShareCode.size() <= 64 &&
        d.companyName is string && d.companyName.size() >= 1 && d.companyName.size() <= 200 &&
        d.mobile is string && d.email is string && d.address is string &&
        d.upiId is string && d.payeeName is string &&
        d.logoBase64 is string && d.authorisedSignatureBase64 is string && d.fallbackQrBase64 is string &&
        d.headerNote is string && d.voiceLogin is string && d.voicePostLogin is string &&
        d.voiceBillStart is string && d.voiceBillDone is string && d.voiceModelId is string &&
        d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 100 &&
        request.auth.uid in d.memberUids &&
        d.createdAt is timestamp && d.createdAt <= request.time &&
        d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidBillData(d) {
      return d.keys().hasAll([
          'billId', 'invoiceNo', 'date', 'customerName', 'customerDetails',
          'itemsJson', 'subtotal', 'discount', 'grandTotal', 'paidAmount',
          'dueAmount', 'paymentMode', 'signatureBase64', 'customQrText',
          'createdBy', 'createdByUid', 'extraChargeType', 'extraChargeAmount',
          'secondaryChargeType', 'secondaryChargeAmount',
          'staffRating', 'staffReviewNote', 'documentType', 'helpBill',
          'helpRequestId', 'quotationNote', 'updatedAt'
        ]) &&
        d.keys().hasOnly([
          'billId', 'invoiceNo', 'date', 'customerName', 'customerDetails',
          'itemsJson', 'subtotal', 'discount', 'grandTotal', 'paidAmount',
          'dueAmount', 'paymentMode', 'paymentStatus', 'linkedPaymentId', 'stockDeducted',
          'signatureBase64', 'customQrText',
          'createdBy', 'createdByUid', 'extraChargeType', 'extraChargeAmount',
          'secondaryChargeType', 'secondaryChargeAmount',
          'staffRating', 'staffReviewNote', 'documentType', 'helpBill',
          'helpRequestId', 'quotationNote', 'updatedAt'
        ]) &&
        d.billId is string && d.billId.size() >= 1 && d.billId.size() <= 128 &&
        d.invoiceNo is string && d.invoiceNo.size() >= 1 && d.invoiceNo.size() <= 64 &&
        d.date is string &&
        d.customerName is string && d.customerDetails is string &&
        d.itemsJson is string && d.itemsJson.size() <= 200000 &&
        d.subtotal is number && d.subtotal >= 0 &&
        d.discount is number && d.discount >= 0 &&
        d.grandTotal is number && d.grandTotal >= 0 &&
        d.paidAmount is number && d.paidAmount >= 0 &&
        d.dueAmount is number && d.dueAmount >= 0 &&
        d.paymentMode is string &&
        (!('paymentStatus' in d) || d.paymentStatus in ['PAID', 'PARTIAL', 'UNPAID']) &&
        (!('linkedPaymentId' in d) || d.linkedPaymentId is string) &&
        (!('stockDeducted' in d) || d.stockDeducted is bool) &&
        d.signatureBase64 is string && d.customQrText is string &&
        d.createdBy is string && d.createdBy.size() >= 1 &&
        d.createdByUid is string && d.createdByUid.size() >= 1 &&
        d.extraChargeType is string &&
        d.extraChargeAmount is number && d.extraChargeAmount >= 0 &&
        d.secondaryChargeType is string &&
        d.secondaryChargeAmount is number && d.secondaryChargeAmount >= 0 &&
        d.staffRating is int && d.staffRating >= 0 && d.staffRating <= 5 &&
        d.staffReviewNote is string &&
        d.documentType in ['BILL', 'QUOTATION'] &&
        d.helpBill is bool &&
        d.helpRequestId is int && d.helpRequestId >= 0 &&
        d.quotationNote is string &&
        d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    // ===== Backend-Only Secret Collections (Zero Client SDK Access) =====

    match /otpChallenges/{id} {
      allow read, write: if false;
    }

    match /otpRateLimits/{id} {
      allow read, write: if false;
    }

    match /passkeyChallenges/{id} {
      allow read, write: if false;
    }

    match /passkeyCredentials/{id} {
      allow read, write: if false;
    }

    match /processedWebhookEvents/{id} {
      allow read, write: if false;
    }

    match /secondFactorSecrets/{id} {
      allow read, write: if false;
    }

    // ===== Role Allowlists =====

    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update: if isBootstrappedAdmin() &&
        isValidId(userId) &&
        request.resource.data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt']) &&
        request.resource.data.userId == userId &&
        request.resource.data.email is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if isBootstrappedAdmin();
    }

    match /superAdmins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ===== Company Scope & Product Combo Files (Part 11) =====

    match /companies/{companyId} {
      allow get: if isWorkspaceMember(companyId);
      allow list: if false;
      allow create, update: if isWorkspaceAdmin(companyId) &&
        request.resource.data.companyId == companyId &&
        request.resource.data.companyName == 'TOTAL SOLUTION';
      allow delete: if false;

      match /productComboFiles/{comboFileId} {
        allow get, list: if isWorkspaceMember(companyId);
        allow create: if isWorkspaceAdmin(companyId) && isValidId(comboFileId) &&
          request.resource.data.keys().hasAll([
            'comboFileId', 'companyId', 'name', 'description', 'itemsJson', 'comboPrice', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'comboFileId', 'companyId', 'name', 'description', 'itemsJson', 'comboPrice', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.comboFileId == comboFileId &&
          request.resource.data.companyId == companyId &&
          request.resource.data.name is string && request.resource.data.name.size() >= 1 &&
          request.resource.data.description is string &&
          request.resource.data.itemsJson is string && request.resource.data.itemsJson.size() <= 200000 &&
          request.resource.data.comboPrice is number && request.resource.data.comboPrice >= 0 &&
          request.resource.data.createdAt is int &&
          request.resource.data.updatedAt is int;
        allow update: if isWorkspaceAdmin(companyId) &&
          request.resource.data.comboFileId == resource.data.comboFileId &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.name is string && request.resource.data.name.size() >= 1 &&
          request.resource.data.comboPrice is number && request.resource.data.comboPrice >= 0;
        allow delete: if isWorkspaceAdmin(companyId);
      }
    }

    // ===== Super Admin ONLY Employee & Salary Management (Parts 16 & 17) =====

    match /employees/{employeeId} {
      allow get, list: if resource.data.companyId is string && isStrictSuperAdmin(resource.data.companyId);
      allow create: if isValidId(employeeId) &&
        request.resource.data.companyId is string &&
        isStrictSuperAdmin(request.resource.data.companyId) &&
        request.resource.data.keys().hasAll([
          'employeeId', 'employeeCode', 'companyId', 'name', 'mobile', 'hiringDate',
          'workStartDate', 'workStopDate', 'monthlySalary', 'address', 'notes',
          'isActive', 'createdAt', 'updatedAt', 'createdByUid'
        ]) &&
        request.resource.data.keys().hasOnly([
          'employeeId', 'employeeCode', 'companyId', 'name', 'mobile', 'hiringDate',
          'workStartDate', 'workStopDate', 'monthlySalary', 'address', 'notes',
          'isActive', 'createdAt', 'updatedAt', 'createdByUid'
        ]) &&
        request.resource.data.employeeId == employeeId &&
        request.resource.data.name is string && request.resource.data.name.size() >= 1 &&
        request.resource.data.mobile is string &&
        request.resource.data.monthlySalary is number && request.resource.data.monthlySalary >= 0 &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if resource.data.companyId is string &&
        isStrictSuperAdmin(resource.data.companyId) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.monthlySalary is number && request.resource.data.monthlySalary >= 0;
      allow delete: if resource.data.companyId is string && isStrictSuperAdmin(resource.data.companyId);

      match /salaryPayments/{paymentId} {
        allow get, list: if isStrictSuperAdmin(get(/databases/$(database)/documents/employees/$(employeeId)).data.companyId);
        allow create: if isValidId(paymentId) &&
          isStrictSuperAdmin(get(/databases/$(database)/documents/employees/$(employeeId)).data.companyId) &&
          request.resource.data.keys().hasAll([
            'paymentId', 'employeeId', 'companyId', 'amount', 'paymentDate', 'method',
            'referenceNo', 'notes', 'cycleStart', 'cycleEnd', 'createdAt', 'createdByUid'
          ]) &&
          request.resource.data.keys().hasOnly([
            'paymentId', 'employeeId', 'companyId', 'amount', 'paymentDate', 'method',
            'referenceNo', 'notes', 'cycleStart', 'cycleEnd', 'createdAt', 'createdByUid'
          ]) &&
          request.resource.data.paymentId == paymentId &&
          request.resource.data.employeeId == employeeId &&
          request.resource.data.amount is number && request.resource.data.amount > 0 &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===== Workspace Directory & Shared Business Collections =====

    match /workspaceDirectories/{shareCode} {
      allow get: if isSignedIn() && isValidId(shareCode);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(shareCode) &&
        shareCode.size() >= 8 &&
        request.resource.data.keys().hasAll(['shareCode', 'workspaceId', 'ownerUid', 'role', 'companyName', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['shareCode', 'workspaceId', 'ownerUid', 'role', 'companyName', 'createdAt', 'updatedAt']) &&
        request.resource.data.shareCode == shareCode &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.role in ['technician', 'super_admin'] &&
        request.resource.data.workspaceId is string && request.resource.data.workspaceId.size() >= 4 &&
        request.resource.data.companyName is string &&
        request.resource.data.createdAt is timestamp && request.resource.data.createdAt <= request.time &&
        request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
      allow update: if (isBootstrappedAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'updatedAt']) &&
        request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
      allow delete: if isBootstrappedAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.uid in resource.data.memberUids && isMemberLoginActive(workspaceId)) ||
        (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) && isMemberLoginActive(workspaceId))
      );
      allow list: if isSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );
      allow create: if isSignedIn() && request.auth.token.email_verified == true && isValidId(workspaceId) && isValidWorkspaceCreate(workspaceId);
      allow update: if isSignedIn() && (isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'companyName', 'mobile', 'email', 'address', 'upiId', 'payeeName',
          'logoBase64', 'authorisedSignatureBase64', 'fallbackQrBase64',
          'headerNote', 'voiceLogin', 'voicePostLogin', 'voiceBillStart',
          'voiceBillDone', 'voiceModelId', 'memberUids', 'techShareCode',
          'superShareCode', 'updatedAt'
        ]) &&
        request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
      allow delete: if isBootstrappedAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /members/{memberUid} {
        allow get: if isWorkspaceMember(workspaceId) || (isSignedIn() && request.auth.uid == memberUid);
        allow list: if isWorkspaceAdmin(workspaceId);
        allow create: if isSignedIn() && isValidId(memberUid) &&
          !('password' in request.resource.data) &&
          !('initialPassword' in request.resource.data) &&
          !('activationPasskey' in request.resource.data) &&
          request.resource.data.keys().hasAll(['userId', 'email', 'displayName', 'role', 'inviteCode', 'createdAt', 'updatedAt']) &&
          request.resource.data.keys().hasOnly([
            'userId', 'uid', 'techId', 'email', 'displayName', 'name', 'username', 'phone',
            'role', 'workspaceId', 'companyId', 'inviteCode', 'mustChangePassword', 'firstLoginCompleted',
            'loginEnabled', 'authProvider', 'activationPasskeyHash', 'activationPasskeyCreatedAt', 'activatedAt',
            'createdByUid', 'passwordChangedAt', 'statusUpdatedAt', 'statusUpdatedByUid', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.userId == memberUid &&
          request.resource.data.email is string &&
          request.resource.data.displayName is string &&
          request.resource.data.inviteCode is string &&
          (!('mustChangePassword' in request.resource.data) || request.resource.data.mustChangePassword is bool) &&
          (!('loginEnabled' in request.resource.data) || request.resource.data.loginEnabled is bool) &&
          (!('activationPasskeyHash' in request.resource.data) || request.resource.data.activationPasskeyHash is string) &&
          (!('workspaceId' in request.resource.data) || request.resource.data.workspaceId == workspaceId) &&
          request.resource.data.createdAt is timestamp && request.resource.data.createdAt <= request.time &&
          request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time &&
          (
            isWorkspaceAdmin(workspaceId) ||
            (
              request.auth.uid == memberUid &&
              (
                (request.resource.data.role == 'technician' &&
                  request.resource.data.inviteCode == workspaceDoc(workspaceId).data.techShareCode) ||
                (request.resource.data.role == 'super_admin' &&
                  request.resource.data.inviteCode == workspaceDoc(workspaceId).data.superShareCode)
              )
            )
          );
        allow update: if !('password' in request.resource.data) &&
          !('initialPassword' in request.resource.data) &&
          !('activationPasskey' in request.resource.data) && (
          (
            isWorkspaceAdmin(workspaceId) &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'name', 'username', 'phone', 'email', 'role', 'techId',
              'loginEnabled', 'statusUpdatedAt', 'statusUpdatedByUid',
              'mustChangePassword', 'firstLoginCompleted', 'activationPasskeyHash',
              'activationPasskeyCreatedAt', 'activatedAt', 'updatedAt'
            ]) &&
            request.resource.data.role in ['admin', 'technician', 'super_admin']
          ) || (
            isSignedIn() &&
            request.auth.uid == memberUid &&
            isMemberLoginActive(workspaceId) &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.get('loginEnabled', true) == resource.data.get('loginEnabled', true) &&
            resource.data.mustChangePassword == true &&
            request.resource.data.mustChangePassword == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'mustChangePassword', 'firstLoginCompleted', 'passwordChangedAt', 'updatedAt'
            ]) &&
            (!('passwordChangedAt' in request.resource.data) ||
              (request.resource.data.passwordChangedAt is timestamp && request.resource.data.passwordChangedAt <= request.time))
          )
        ) && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /accounts/{accountId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) && isValidId(accountId) &&
          request.resource.data.keys().hasAll(['username', 'displayName', 'passwordHash', 'role', 'phone', 'photoBase64', 'updatedAt']) &&
          request.resource.data.keys().hasOnly([
            'username', 'displayName', 'passwordHash', 'role', 'phone', 'photoBase64',
            'email', 'uid', 'techId', 'companyId', 'loginEnabled', 'updatedAt'
          ]) &&
          request.resource.data.username is string && request.resource.data.username.size() >= 3 &&
          request.resource.data.displayName is string &&
          request.resource.data.passwordHash is string && request.resource.data.passwordHash.size() >= 16 &&
          request.resource.data.role in ['admin', 'technician', 'super_admin'] &&
          request.resource.data.phone is string &&
          request.resource.data.photoBase64 is string &&
          request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow update: if isWorkspaceAdmin(workspaceId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'username', 'displayName', 'passwordHash', 'role', 'phone', 'photoBase64',
            'email', 'uid', 'techId', 'companyId', 'loginEnabled', 'updatedAt'
          ]) &&
          request.resource.data.role in ['admin', 'technician', 'super_admin'] &&
          request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /products/{productId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) && isValidId(productId) &&
          request.resource.data.keys().hasAll(['productId', 'name', 'unit', 'defaultRate', 'folder', 'updatedAt']) &&
          request.resource.data.keys().hasOnly([
            'productId', 'name', 'unit', 'defaultRate', 'purchasePrice', 'sku', 'barcode',
            'folder', 'stockQty', 'minStockAlert', 'updatedAt'
          ]) &&
          request.resource.data.productId == productId &&
          request.resource.data.name is string && request.resource.data.name.size() >= 1 &&
          request.resource.data.unit is string &&
          request.resource.data.defaultRate is number && request.resource.data.defaultRate >= 0 &&
          (!('purchasePrice' in request.resource.data) || (request.resource.data.purchasePrice is number && request.resource.data.purchasePrice >= 0)) &&
          (!('sku' in request.resource.data) || request.resource.data.sku is string) &&
          (!('barcode' in request.resource.data) || request.resource.data.barcode is string) &&
          request.resource.data.folder is string &&
          (!('stockQty' in request.resource.data) ||
            (request.resource.data.stockQty is number && request.resource.data.stockQty >= 0)) &&
          (!('minStockAlert' in request.resource.data) ||
            (request.resource.data.minStockAlert is number && request.resource.data.minStockAlert >= 0)) &&
          request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow update: if (
          (
            isWorkspaceAdmin(workspaceId) &&
            request.resource.data.productId == resource.data.productId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'unit', 'defaultRate', 'purchasePrice', 'sku', 'barcode',
              'folder', 'stockQty', 'minStockAlert', 'updatedAt'
            ]) &&
            request.resource.data.name is string && request.resource.data.name.size() >= 1 &&
            request.resource.data.defaultRate is number && request.resource.data.defaultRate >= 0 &&
            (!('purchasePrice' in request.resource.data) || (request.resource.data.purchasePrice is number && request.resource.data.purchasePrice >= 0)) &&
            (!('stockQty' in request.resource.data) ||
              (request.resource.data.stockQty is number && request.resource.data.stockQty >= 0)) &&
            (!('minStockAlert' in request.resource.data) ||
              (request.resource.data.minStockAlert is number && request.resource.data.minStockAlert >= 0))
          ) || (
            isTechnicianMember(workspaceId) &&
            request.resource.data.productId == resource.data.productId &&
            request.resource.data.name == resource.data.name &&
            request.resource.data.unit == resource.data.unit &&
            request.resource.data.defaultRate == resource.data.defaultRate &&
            request.resource.data.folder == resource.data.folder &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'stockQty', 'minStockAlert', 'updatedAt'
            ]) &&
            (!('minStockAlert' in resource.data) ||
              request.resource.data.minStockAlert == resource.data.minStockAlert) &&
            request.resource.data.stockQty is number && request.resource.data.stockQty >= 0 &&
            request.resource.data.stockQty <= resource.data.get('stockQty', 0) &&
            (!('minStockAlert' in request.resource.data) ||
              (request.resource.data.minStockAlert is number && request.resource.data.minStockAlert >= 0))
          )
        ) && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /customers/{customerId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if (isWorkspaceAdmin(workspaceId) || isTechnicianMember(workspaceId)) && isValidId(customerId) &&
          request.resource.data.keys().hasAll(['customerId', 'name', 'details', 'phone', 'address', 'locationUrl', 'updatedByUid', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['customerId', 'name', 'details', 'phone', 'address', 'locationUrl', 'updatedByUid', 'updatedAt']) &&
          request.resource.data.customerId == customerId &&
          request.resource.data.name is string && request.resource.data.name.size() >= 1 &&
          request.resource.data.details is string &&
          request.resource.data.phone is string &&
          request.resource.data.address is string &&
          request.resource.data.locationUrl is string &&
          request.resource.data.updatedByUid == request.auth.uid &&
          request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow update: if (isWorkspaceAdmin(workspaceId) || isTechnicianMember(workspaceId)) &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'details', 'phone', 'address', 'locationUrl', 'updatedByUid', 'updatedAt'
          ]) &&
          request.resource.data.updatedByUid == request.auth.uid &&
          request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /bills/{billId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isValidId(billId) &&
          isValidBillData(request.resource.data) &&
          request.resource.data.billId == billId &&
          (
            isWorkspaceAdmin(workspaceId) ||
            (isTechnicianMember(workspaceId) && request.resource.data.createdByUid == request.auth.uid)
          );
        allow update: if isValidBillData(request.resource.data) &&
          request.resource.data.billId == resource.data.billId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'invoiceNo', 'date', 'customerName', 'customerDetails', 'itemsJson',
            'subtotal', 'discount', 'grandTotal', 'paidAmount', 'dueAmount',
            'paymentMode', 'paymentStatus', 'linkedPaymentId', 'stockDeducted',
            'signatureBase64', 'customQrText', 'createdBy',
            'extraChargeType', 'extraChargeAmount', 'secondaryChargeType', 'secondaryChargeAmount',
            'staffRating', 'staffReviewNote',
            'documentType', 'helpBill', 'helpRequestId', 'quotationNote', 'updatedAt'
          ]) &&
          (resource.data.staffRating == 0 ||
            (request.resource.data.staffRating == resource.data.staffRating &&
             request.resource.data.staffReviewNote == resource.data.staffReviewNote)) &&
          (
            isWorkspaceAdmin(workspaceId) ||
            (isTechnicianMember(workspaceId) && resource.data.createdByUid == request.auth.uid && resource.data.staffRating == 0)
          );
        allow delete: if isWorkspaceAdmin(workspaceId) && resource.data.staffRating == 0;
      }

      match /upiTransactions/{paymentId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        // Zero-trust rule: clients can NEVER create or mark transactions as SUCCESS/PAID.
        // Only the server-side payment gateway webhook Cloud Function (Admin SDK) marks SUCCESS/PAID.
        allow create: if isWorkspaceMember(workspaceId) && isValidId(paymentId) &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.get('verifiedByWebhook', false) == false;
        allow update: if isWorkspaceMember(workspaceId) &&
          resource.data.status == 'PENDING' &&
          request.resource.data.status in ['CANCELLED', 'EXPIRED'] &&
          request.resource.data.get('verifiedByWebhook', false) == false;
        allow delete: if false;
      }

      match /helpRequests/{helpId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isValidId(helpId) &&
          request.resource.data.keys().hasAll([
            'helpId', 'customerName', 'phone', 'address', 'locationUrl',
            'helpDescription', 'status', 'createdAt', 'updatedAt',
            'acceptedBy', 'acceptedByUid', 'acceptedByName', 'acceptedByPhone',
            'acceptedAt', 'solvedAt', 'billId'
          ]) &&
          request.resource.data.keys().hasOnly([
            'helpId', 'helpTokenId', 'quotationId', 'approvedQuotationJson',
            'customerName', 'phone', 'address', 'locationUrl',
            'helpDescription', 'category', 'quotationStatus', 'installationDate',
            'installationReminderSent', 'rejectedReason', 'assignedTechnician',
            'status', 'createdAt', 'updatedAt',
            'acceptedBy', 'acceptedByUid', 'acceptedByName', 'acceptedByPhone',
            'acceptedAt', 'solvedAt', 'billId'
          ]) &&
          (!('category' in request.resource.data) ||
            request.resource.data.category in ['REGULAR_SERVICE', 'EMERGENCY', 'INSTALLATION', 'QUOTATION']) &&
          (!('quotationStatus' in request.resource.data) ||
            request.resource.data.quotationStatus in ['', 'PENDING', 'APPROVED', 'REJECTED']) &&
          (!('installationDate' in request.resource.data) || request.resource.data.installationDate is string) &&
          (!('installationReminderSent' in request.resource.data) || request.resource.data.installationReminderSent is bool) &&
          (!('rejectedReason' in request.resource.data) || request.resource.data.rejectedReason is string) &&
          (!('assignedTechnician' in request.resource.data) || request.resource.data.assignedTechnician is string) &&
          (!('helpTokenId' in request.resource.data) || request.resource.data.helpTokenId is string) &&
          (!('quotationId' in request.resource.data) || request.resource.data.quotationId is string) &&
          (!('approvedQuotationJson' in request.resource.data) || request.resource.data.approvedQuotationJson is string) &&
          (
            (
              isWorkspaceAdmin(workspaceId) &&
              request.resource.data.status in [
                'OPEN', 'ACCEPTED', 'POSTPONED', 'INSTALLATION_IN_PROGRESS',
                'INSTALLATION_COMPLETED', 'BILLED', 'SOLVED', 'NOT_SOLVED', 'RESOLVED', 'REJECTED'
              ]
            ) || (
              isTechnicianMember(workspaceId) &&
              request.resource.data.get('category', '') == 'QUOTATION' &&
              request.resource.data.get('quotationStatus', '') == 'PENDING' &&
              request.resource.data.status == 'OPEN'
            )
          );
        allow update: if (
          isWorkspaceAdmin(workspaceId) &&
          request.resource.data.status in [
            'OPEN', 'ACCEPTED', 'POSTPONED', 'INSTALLATION_IN_PROGRESS',
            'INSTALLATION_COMPLETED', 'BILLED', 'SOLVED', 'NOT_SOLVED', 'RESOLVED', 'REJECTED'
          ] &&
          (!('category' in request.resource.data) ||
            request.resource.data.category in ['REGULAR_SERVICE', 'EMERGENCY', 'INSTALLATION', 'QUOTATION']) &&
          (!('quotationStatus' in request.resource.data) ||
            request.resource.data.quotationStatus in ['', 'PENDING', 'APPROVED', 'REJECTED'])
        ) || (
          isTechnicianMember(workspaceId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedBy', 'acceptedByUid', 'acceptedByName',
            'acceptedByPhone', 'acceptedAt', 'solvedAt', 'billId', 'rejectedReason', 'updatedAt'
          ]) &&
          request.resource.data.status in [
            'ACCEPTED', 'POSTPONED', 'INSTALLATION_IN_PROGRESS',
            'INSTALLATION_COMPLETED', 'BILLED', 'SOLVED', 'NOT_SOLVED', 'REJECTED'
          ] &&
          (!('rejectedReason' in request.resource.data) || request.resource.data.rejectedReason is string) &&
          (resource.data.acceptedByUid == '' || resource.data.acceptedByUid == request.auth.uid)
        );
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /settlements/{settlementId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) && isValidId(settlementId) &&
          request.resource.data.keys().hasAll([
            'settlementId', 'technicianUsername', 'amount', 'note', 'recordedBy', 'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'settlementId', 'technicianUsername', 'amount', 'note', 'recordedBy', 'createdAt'
          ]) &&
          request.resource.data.settlementId == settlementId &&
          request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update, delete: if isWorkspaceAdmin(workspaceId);
      }

      match /expenses/{expenseId} {
        allow get, list: if isWorkspaceAdmin(workspaceId) || isSuperAdminMember(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) && isValidId(expenseId) &&
          request.resource.data.keys().hasAll([
            'expenseId', 'title', 'category', 'amount', 'date', 'note',
            'recordedBy', 'createdAt', 'updatedAt', 'serverUpdatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'expenseId', 'title', 'category', 'amount', 'date', 'note',
            'recordedBy', 'createdAt', 'updatedAt', 'serverUpdatedAt'
          ]) &&
          request.resource.data.expenseId == expenseId &&
          request.resource.data.title is string && request.resource.data.title.size() >= 1 &&
          request.resource.data.category is string &&
          request.resource.data.amount is number && request.resource.data.amount >= 0 &&
          request.resource.data.date is string &&
          request.resource.data.note is string &&
          request.resource.data.recordedBy is string &&
          request.resource.data.createdAt is int &&
          request.resource.data.updatedAt is int &&
          request.resource.data.serverUpdatedAt is timestamp && request.resource.data.serverUpdatedAt <= request.time;
        allow update: if isWorkspaceAdmin(workspaceId) &&
          request.resource.data.expenseId == resource.data.expenseId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'category', 'amount', 'date', 'note', 'recordedBy', 'updatedAt', 'serverUpdatedAt'
          ]) &&
          request.resource.data.title is string && request.resource.data.title.size() >= 1 &&
          request.resource.data.amount is number && request.resource.data.amount >= 0 &&
          request.resource.data.updatedAt is int &&
          request.resource.data.serverUpdatedAt is timestamp && request.resource.data.serverUpdatedAt <= request.time;
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /trash/{trashId} {
        allow get, list: if isWorkspaceAdmin(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) && isValidId(trashId) &&
          request.resource.data.keys().hasAll([
            'trashId', 'entityType', 'entityId', 'title', 'summary', 'payloadJson',
            'deletedBy', 'deletedByRole', 'status', 'deletedAt', 'deletedAtMillis',
            'expireAt', 'restoredAt', 'restoredBy'
          ]) &&
          request.resource.data.keys().hasOnly([
            'trashId', 'entityType', 'entityId', 'title', 'summary', 'payloadJson',
            'deletedBy', 'deletedByRole', 'status', 'deletedAt', 'deletedAtMillis',
            'expireAt', 'restoredAt', 'restoredBy'
          ]) &&
          request.resource.data.trashId == trashId &&
          request.resource.data.entityType in ['BILL', 'CUSTOMER', 'PRODUCT', 'EXPENSE', 'HELP', 'HELP_REQUEST', 'SETTLEMENT', 'COMBO_FILE'] &&
          request.resource.data.entityId is string && request.resource.data.entityId.size() >= 1 &&
          request.resource.data.title is string &&
          request.resource.data.summary is string &&
          request.resource.data.payloadJson is string && request.resource.data.payloadJson.size() <= 300000 &&
          request.resource.data.deletedBy is string &&
          request.resource.data.deletedByRole is string &&
          request.resource.data.status == 'TRASHED' &&
          request.resource.data.deletedAt is timestamp && request.resource.data.deletedAt <= request.time &&
          request.resource.data.deletedAtMillis is int &&
          request.resource.data.expireAt is timestamp &&
          request.resource.data.restoredAt is int &&
          request.resource.data.restoredBy is string;
        allow update: if isWorkspaceAdmin(workspaceId) &&
          resource.data.status == 'TRASHED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'restoredAt', 'restoredBy']) &&
          request.resource.data.status == 'RESTORED' &&
          request.resource.data.restoredAt is int &&
          request.resource.data.restoredBy is string;
        allow delete: if isWorkspaceAdmin(workspaceId) &&
          resource.data.deletedAt is timestamp &&
          request.time >= resource.data.deletedAt + duration.value(24, 'h');
      }

      match /auditLogs/{logId} {
        allow get, list: if isWorkspaceAdmin(workspaceId) || isSuperAdminMember(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) && isValidId(logId) &&
          request.resource.data.keys().hasAll([
            'logId', 'action', 'entityType', 'entityId', 'title',
            'actorUsername', 'actorRole', 'details', 'createdAt', 'serverCreatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'logId', 'action', 'entityType', 'entityId', 'title',
            'actorUsername', 'actorRole', 'details', 'createdAt', 'serverCreatedAt'
          ]) &&
          request.resource.data.logId == logId &&
          request.resource.data.action is string && request.resource.data.action.size() >= 1 &&
          request.resource.data.entityType is string &&
          request.resource.data.entityId is string &&
          request.resource.data.title is string &&
          request.resource.data.actorUsername is string &&
          request.resource.data.actorRole is string &&
          request.resource.data.details is string &&
          request.resource.data.createdAt is int &&
          request.resource.data.serverCreatedAt is timestamp && request.resource.data.serverCreatedAt <= request.time;
        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if (isWorkspaceAdmin(workspaceId) || isTechnicianMember(workspaceId)) &&
          isValidId(notifId) &&
          request.resource.data.keys().hasAll([
            'notifId', 'category', 'title', 'message', 'targetRole',
            'targetUsername', 'createdBy', 'createdByUid', 'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'notifId', 'category', 'title', 'message', 'targetRole',
            'targetUsername', 'createdBy', 'createdByUid', 'createdAt'
          ]) &&
          request.resource.data.notifId == notifId &&
          request.resource.data.category in ['PRODUCT', 'STOCK', 'CUSTOMER', 'BILLING', 'PAYMENT', 'SERVICE_REQUEST', 'QUOTATION', 'INSTALLATION', 'SYSTEM'] &&
          request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 160 &&
          request.resource.data.message is string && request.resource.data.message.size() <= 500 &&
          request.resource.data.targetRole in ['all', 'admin', 'technician', 'super_admin'] &&
          request.resource.data.targetUsername is string &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.createdAt is timestamp && request.resource.data.createdAt <= request.time;
        allow update, delete: if false;
      }
    }

    // Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
