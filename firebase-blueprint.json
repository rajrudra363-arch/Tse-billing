{
  "entities": {
    "AdminMarker": {
      "title": "Admin Marker",
      "description": "Bootstrapped system admin record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "WorkspaceDirectory": {
      "title": "Workspace Invite Directory",
      "description": "Maps an unguessable role-specific invite code to its workspace without exposing PII.",
      "type": "object",
      "properties": {
        "shareCode": { "type": "string" },
        "workspaceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "role": { "type": "string", "enum": ["technician", "super_admin"] },
        "companyName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shareCode", "workspaceId", "ownerUid", "role", "companyName", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Company Billing Workspace",
      "description": "Shared company settings, branding, voice prompts, UPI settings, and workspace membership.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "techShareCode": { "type": "string" },
        "superShareCode": { "type": "string" },
        "companyName": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "upiId": { "type": "string" },
        "payeeName": { "type": "string" },
        "logoBase64": { "type": "string" },
        "authorisedSignatureBase64": { "type": "string" },
        "fallbackQrBase64": { "type": "string" },
        "headerNote": { "type": "string" },
        "voiceLogin": { "type": "string" },
        "voicePostLogin": { "type": "string" },
        "voiceBillStart": { "type": "string" },
        "voiceBillDone": { "type": "string" },
        "voiceModelId": { "type": "string" },
        "memberUids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "ownerUid", "ownerEmail", "techShareCode", "superShareCode",
        "companyName", "mobile", "email", "address", "upiId", "payeeName",
        "logoBase64", "authorisedSignatureBase64", "fallbackQrBase64",
        "headerNote", "voiceLogin", "voicePostLogin", "voiceBillStart",
        "voiceBillDone", "voiceModelId", "memberUids", "createdAt", "updatedAt"
      ]
    },
    "WorkspaceMember": {
      "title": "Workspace Member",
      "description": "Binds a signed-in Google Firebase Auth UID to a role inside a workspace.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "technician", "super_admin"] },
        "inviteCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "role", "inviteCode", "createdAt", "updatedAt"]
    },
    "WorkspaceAccount": {
      "title": "Workspace Account",
      "description": "Role account (Admin, Technician, or Super Admin) managed by Admin inside the workspace.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "technician", "super_admin"] },
        "phone": { "type": "string" },
        "photoBase64": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "displayName", "passwordHash", "role", "phone", "photoBase64", "updatedAt"]
    },
    "WorkspaceBill": {
      "title": "Bill or Quotation",
      "description": "Tax Invoice or Quotation generated by Admin or Technician and synced live to Admin and Super Admin.",
      "type": "object",
      "properties": {
        "billId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "customerDetails": { "type": "string" },
        "itemsJson": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "paymentMode": { "type": "string" },
        "signatureBase64": { "type": "string" },
        "customQrText": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByUid": { "type": "string" },
        "extraChargeType": { "type": "string" },
        "extraChargeAmount": { "type": "number" },
        "secondaryChargeType": { "type": "string" },
        "secondaryChargeAmount": { "type": "number" },
        "staffRating": { "type": "integer" },
        "staffReviewNote": { "type": "string" },
        "documentType": { "type": "string", "enum": ["BILL", "QUOTATION"] },
        "helpBill": { "type": "boolean" },
        "helpRequestId": { "type": "integer" },
        "quotationNote": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "billId", "invoiceNo", "date", "customerName", "customerDetails",
        "itemsJson", "subtotal", "discount", "grandTotal", "paidAmount",
        "dueAmount", "paymentMode", "signatureBase64", "customQrText",
        "createdBy", "createdByUid", "extraChargeType", "extraChargeAmount",
        "secondaryChargeType", "secondaryChargeAmount",
        "staffRating", "staffReviewNote", "documentType", "helpBill",
        "helpRequestId", "quotationNote", "updatedAt"
      ]
    },
    "WorkspaceCustomer": {
      "title": "Customer Record",
      "description": "Synced customer record shared across the workspace.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "name": { "type": "string" },
        "details": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "locationUrl": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "name", "details", "phone", "address", "locationUrl", "updatedByUid", "updatedAt"]
    },
    "WorkspaceProduct": {
      "title": "Product Catalog Item",
      "description": "CCTV product with category folder, default rate, and inventory stock levels.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "defaultRate": { "type": "number" },
        "folder": { "type": "string" },
        "stockQty": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "name", "unit", "defaultRate", "folder", "stockQty", "minStockAlert", "updatedAt"]
    },
    "WorkspaceHelpRequest": {
      "title": "Customer Help Request",
      "description": "Support dispatch job tracked across Admin and Technicians.",
      "type": "object",
      "properties": {
        "helpId": { "type": "integer" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "locationUrl": { "type": "string" },
        "helpDescription": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "ACCEPTED", "SOLVED", "NOT_SOLVED", "RESOLVED"] },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "acceptedBy": { "type": "string" },
        "acceptedByUid": { "type": "string" },
        "acceptedByName": { "type": "string" },
        "acceptedByPhone": { "type": "string" },
        "acceptedAt": { "type": "integer" },
        "solvedAt": { "type": "integer" },
        "billId": { "type": "string" }
      },
      "required": [
        "helpId", "customerName", "phone", "address", "locationUrl",
        "helpDescription", "status", "createdAt", "updatedAt",
        "acceptedBy", "acceptedByUid", "acceptedByName", "acceptedByPhone",
        "acceptedAt", "solvedAt", "billId"
      ]
    },
    "WorkspaceSettlement": {
      "title": "Technician Cash Settlement",
      "description": "Cash settlement record handed by Technician to Admin.",
      "type": "object",
      "properties": {
        "settlementId": { "type": "string" },
        "technicianUsername": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["settlementId", "technicianUsername", "amount", "note", "recordedBy", "createdAt"]
    },
    "WorkspaceExpense": {
      "title": "Business Expense",
      "description": "Operational expense tracked by Admin for net profit calculation and Super Admin read-only analytics.",
      "type": "object",
      "properties": {
        "expenseId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "expenseId", "title", "category", "amount", "date", "note",
        "recordedBy", "createdAt", "updatedAt", "serverUpdatedAt"
      ]
    },
    "WorkspaceTrashItem": {
      "title": "24-Hour Soft-Delete Trash Item",
      "description": "Recoverable deleted record enforced by Firestore security rules to wait 24 hours before permanent deletion.",
      "type": "object",
      "properties": {
        "trashId": { "type": "string" },
        "entityType": { "type": "string", "enum": ["BILL", "CUSTOMER", "PRODUCT", "EXPENSE", "HELP_REQUEST"] },
        "entityId": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "payloadJson": { "type": "string" },
        "deletedBy": { "type": "string" },
        "deletedByRole": { "type": "string" },
        "status": { "type": "string", "enum": ["TRASHED", "RESTORED"] },
        "deletedAt": { "type": "string", "format": "date-time" },
        "deletedAtMillis": { "type": "integer" },
        "expireAt": { "type": "string", "format": "date-time" },
        "restoredAt": { "type": "integer" },
        "restoredBy": { "type": "string" }
      },
      "required": [
        "trashId", "entityType", "entityId", "title", "summary", "payloadJson",
        "deletedBy", "deletedByRole", "status", "deletedAt", "deletedAtMillis",
        "expireAt", "restoredAt", "restoredBy"
      ]
    },
    "WorkspaceAuditLog": {
      "title": "Security & Deletion Audit Log",
      "description": "Append-only audit trail for deletions, restores, 24h auto-purges, and expense changes.",
      "type": "object",
      "properties": {
        "logId": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "title": { "type": "string" },
        "actorUsername": { "type": "string" },
        "actorRole": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "integer" },
        "serverCreatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "logId", "action", "entityType", "entityId", "title",
        "actorUsername", "actorRole", "details", "createdAt", "serverCreatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": { "schema": "AdminMarker", "description": "System admin allowlist documents." },
    "/workspaceDirectories/{shareCode}": { "schema": "WorkspaceDirectory", "description": "Secret-token workspace invite resolver." },
    "/workspaces/{workspaceId}": { "schema": "Workspace", "description": "Root company workspace configuration." },
    "/workspaces/{workspaceId}/members/{memberUid}": { "schema": "WorkspaceMember", "description": "Authenticated Firebase member bindings." },
    "/workspaces/{workspaceId}/accounts/{accountId}": { "schema": "WorkspaceAccount", "description": "Workspace username/password accounts." },
    "/workspaces/{workspaceId}/bills/{billId}": { "schema": "WorkspaceBill", "description": "Synced bills and quotations." },
    "/workspaces/{workspaceId}/customers/{customerId}": { "schema": "WorkspaceCustomer", "description": "Synced customers." },
    "/workspaces/{workspaceId}/products/{productId}": { "schema": "WorkspaceProduct", "description": "Synced products catalog with inventory stock." },
    "/workspaces/{workspaceId}/helpRequests/{helpId}": { "schema": "WorkspaceHelpRequest", "description": "Synced help desk tickets." },
    "/workspaces/{workspaceId}/settlements/{settlementId}": { "schema": "WorkspaceSettlement", "description": "Synced technician settlements." },
    "/workspaces/{workspaceId}/expenses/{expenseId}": { "schema": "WorkspaceExpense", "description": "Synced business expenses." },
    "/workspaces/{workspaceId}/trash/{trashId}": { "schema": "WorkspaceTrashItem", "description": "24-hour recoverable trash bin." },
    "/workspaces/{workspaceId}/auditLogs/{logId}": { "schema": "WorkspaceAuditLog", "description": "Append-only security audit trail." }
  }
}
